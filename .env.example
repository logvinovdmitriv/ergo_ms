# -------------------------------------------------------------
# ERGO_MS development environment
# Этот файл используется как шаблон переменных окружения.
# Переименуйте/скопируйте в .env для запуска docker-compose.
# -------------------------------------------------------------

# --- API (Django) ---
# Хост и порт, на которых API слушает внутри контейнера
API_HOST=0.0.0.0
API_PORT=8000

# Тип деплоя: development | production
# Меняет поведение некоторых настроек (логирование и т.д.)
API_DEPLOY_TYPE=development

# Секретный ключ Django (для dev можно оставить как есть)
API_SECRET_KEY=dev

# --- Database (для быстрого старта через docker-compose) ---
# Внутри docker сети Postgres доступен по имени сервиса "db"
# Основная настройка БД берётся из databases.yaml, это значение используется как дефолт
DATABASE_URL=postgresql://postgres:postgres@db:5432/ergo_ms

# --- Celery / Redis ---
# Redis доступен по имени сервиса "redis"
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Migrations ---
# Авто применение миграций при старте (рекомендуется оставить 1 для dev)
AUTO_MIGRATE=1
# Генерация новых миграций автоматически (обычно 0; разработчик создаёт миграции вручную)
AUTO_MAKEMIGRATIONS=0

# --- Client (Vite) ---
# Хост/порт API, к которому будет обращаться клиент из браузера хоста
# Если запускаете API на другом хосте/порту — поменяйте здесь
VITE_API_HOST=localhost
VITE_API_PORT=8000

# --- Upstream compatibility (добавлено для совместимости с веткой dohao/dev) ---
SYSTEM_TITLE=ERGO MS
API_ALLOWED_HOSTS=localhost,127.0.0.1
API_ACCESS_TOKEN_LIFETIME=30
API_REFRESH_TOKEN_LIFETIME=1440
API_THROTTLE_RATES_ANON=10/minute
API_THROTTLE_RATES_USER=5000/hour
CLIENT_HOST=localhost
CLIENT_PORT=8001
EMAIL_HOST_USER=mail
EMAIL_HOST_PASSWORD=password
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=587
EMAIL_USE_TLS=True
API_JUPYTER_HOST=localhost
API_JUPYTER_PORT=8002
VITE_YANDEX_MAPS_API_KEY=secret-key
VITE_LM_STUDIO_URL=http://127.0.0.1:1234
OLLAMA_BASE_URL=http://127.0.0.1:11434
