# Django API
API_DEPLOY_TYPE=development
API_SECRET_KEY=dev
API_ALLOWED_HOSTS=localhost,127.0.0.1
SYSTEM_TITLE=ERGO MS

# Database (used by compose if databases.yaml is not provided)
DATABASE_URL=postgresql://postgres:postgres@db:5432/ergo_ms

# Client (Vite) → where frontend calls API
VITE_API_HOST=localhost
VITE_API_PORT=8000

# Optional email settings (uncomment and fill if needed)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
